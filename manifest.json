// ── 상태 (IndexedDB 사용) ──
let extra = [];
let stars = {};
let words = [];
let filter = 'all';

// IndexedDB setup
const DB_NAME = 'toeic-db';
const DB_VERSION = 1;
let db;

function openDB() {
  return new Promise((resolve, reject) => {
    const req = indexedDB.open(DB_NAME, DB_VERSION);
    req.onupgradeneeded = e => {
      const d = e.target.result;
      if (!d.objectStoreNames.contains('store')) {
        d.createObjectStore('store');
      }
    };
    req.onsuccess = e => { db = e.target.result; resolve(db); };
    req.onerror = () => reject(req.error);
  });
}

function dbGet(key) {
  return new Promise((resolve) => {
    const tx = db.transaction('store', 'readonly');
    const req = tx.objectStore('store').get(key);
    req.onsuccess = () => resolve(req.result ?? null);
    req.onerror = () => resolve(null);
  });
}

function dbSet(key, value) {
  return new Promise((resolve) => {
    const tx = db.transaction('store', 'readwrite');
    tx.objectStore('store').put(value, key);
    tx.oncomplete = resolve;
    tx.onerror = resolve;
  });
}

async function loadData() {
  extra = (await dbGet('extra')) || [];
  stars = (await dbGet('stars')) || {};
  words = [...BASE_WORDS, ...extra];
}

async function saveData() {
  await dbSet('extra', extra);
  await dbSet('stars', stars);
}

// ── UI 함수 ──
function showToast(msg) {
  const t = document.getElementById('toast');
  t.textContent = msg;
  t.classList.add('show');
  setTimeout(() => t.classList.remove('show'), 2200);
}

async function addWord() {
  const en = document.getElementById('inp-en').value.trim();
  const ko = document.getElementById('inp-ko').value.trim();
  if (!en || !ko) { showToast('영어와 한국어 뜻을 모두 입력해주세요'); return; }
  if (words.some(([w]) => w.toLowerCase() === en.toLowerCase())) {
    showToast('이미 있는 단어예요'); return;
  }
  extra.push([en, ko]);
  words = [...BASE_WORDS, ...extra];
  await saveData();
  document.getElementById('inp-en').value = '';
  document.getElementById('inp-ko').value = '';
  document.getElementById('inp-en').focus();
  showToast(`"${en}" 추가됐어요 ✓`);
  render();
}

async function deleteWord(i) {
  const [en] = words[i];
  if (i < BASE_WORDS.length) { showToast('기본 단어는 삭제할 수 없어요'); return; }
  if (!confirm(`"${en}" 을(를) 삭제할까요?`)) return;
  const extraIdx = i - BASE_WORDS.length;
  extra.splice(extraIdx, 1);
  const newStars = {};
  Object.entries(stars).forEach(([k, v]) => {
    const ki = parseInt(k);
    if (ki < i) newStars[k] = v;
    else if (ki > i) newStars[ki - 1] = v;
  });
  stars = newStars;
  words = [...BASE_WORDS, ...extra];
  await saveData();
  showToast(`"${en}" 삭제됐어요`);
  render();
}

function setFilter(f) {
  filter = f;
  document.getElementById('btn-all').className = 'filter-btn' + (f === 'all' ? ' active' : '');
  document.getElementById('btn-star').className = 'filter-btn' + (f === 'star' ? ' active' : '');
  render();
}

async function toggleStar(i) {
  stars[i] = !stars[i];
  await saveData();
  render();
}

function render() {
  document.getElementById('total-badge').textContent = words.length;
  const q = document.getElementById('search').value.trim().toLowerCase();
  let html = '';
  let count = 0;
  words.forEach(([en, ko], i) => {
    if (filter === 'star' && !stars[i]) return;
    if (q && !en.toLowerCase().includes(q) && !ko.includes(q)) return;
    count++;
    const isEven = count % 2 === 0;
    const isCustom = i >= BASE_WORDS.length;
    const bg = isEven ? 'background:var(--row-even)' : '';
    const delBtn = isCustom
      ? `<button class="del-btn" onclick="deleteWord(${i})" title="삭제">✕</button>`
      : `<span style="color:var(--border)">·</span>`;
    html += `<tr style="${bg}">
      <td>${i + 1}</td>
      <td class="en">${en}${isCustom ? '<span class="new-badge">NEW</span>' : ''}</td>
      <td class="ko">${ko}</td>
      <td><button class="star-btn" onclick="toggleStar(${i})">${stars[i] ? '⭐' : '☆'}</button></td>
      <td>${delBtn}</td>
    </tr>`;
  });
  if (!html) html = `<tr><td colspan="5" class="empty">검색 결과가 없어요</td></tr>`;
  document.getElementById('tbody').innerHTML = html;
  const starred = Object.values(stars).filter(Boolean).length;
  document.getElementById('stat').textContent = `${count}개 표시 중 · 즐겨찾기 ${starred}개`;
}

// ── 초기화 ──
openDB().then(loadData).then(render);
</script>
</body>
</html>
