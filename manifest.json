<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#1a1814">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="TOEIC 단어">
<link rel="manifest" href="manifest.json">
<link rel="apple-touch-icon" href="icons/icon-192.png">
<title>TOEIC 단어 암기장</title>
<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

:root {
  --bg: #f7f6f2;
  --surface: #ffffff;
  --border: #e2ddd6;
  --text: #1a1814;
  --text2: #6b6560;
  --text3: #a09b95;
  --accent: #2b5ce6;
  --accent-light: #eef1fc;
  --header-bg: #1a1814;
  --header-text: #f7f6f2;
  --row-even: #faf9f6;
  --green: #2d6a4f;
  --red: #c0392b;
  --safe-top: env(safe-area-inset-top, 0px);
}

html, body { height: 100%; }

body {
  font-family: 'Noto Sans KR', sans-serif;
  background: var(--bg);
  color: var(--text);
  display: flex;
  flex-direction: column;
  height: 100%;
  overflow: hidden;
}

/* ── Top bar ── */
.topbar {
  background: var(--header-bg);
  color: var(--header-text);
  padding: calc(var(--safe-top) + 14px) 16px 14px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-shrink: 0;
  gap: 10px;
}

.topbar h1 {
  font-size: 1.1rem;
  font-weight: 600;
  letter-spacing: -0.02em;
  white-space: nowrap;
}

.count-badge {
  background: var(--accent);
  color: #fff;
  font-size: 0.72rem;
  font-weight: 600;
  padding: 2px 7px;
  border-radius: 20px;
  margin-left: 6px;
  vertical-align: middle;
}

.topbar-actions { display: flex; gap: 6px; }

.icon-btn {
  background: rgba(255,255,255,0.12);
  border: none;
  color: #fff;
  padding: 7px 10px;
  border-radius: 8px;
  cursor: pointer;
  font-size: 0.8rem;
  font-family: inherit;
  font-weight: 500;
  white-space: nowrap;
  transition: background 0.15s;
}
.icon-btn:hover { background: rgba(255,255,255,0.2); }

/* ── Search + filter bar ── */
.controls {
  padding: 10px 12px;
  display: flex;
  gap: 8px;
  align-items: center;
  background: var(--surface);
  border-bottom: 1px solid var(--border);
  flex-shrink: 0;
  flex-wrap: wrap;
}

.search-wrap {
  position: relative;
  flex: 1;
  min-width: 140px;
}
.search-wrap svg {
  position: absolute; left: 10px; top: 50%;
  transform: translateY(-50%);
  color: var(--text3); pointer-events: none;
}
input[type="text"] {
  width: 100%;
  padding: 8px 10px 8px 34px;
  border: 1.5px solid var(--border);
  border-radius: 8px;
  font-size: 0.88rem;
  font-family: inherit;
  background: var(--bg);
  color: var(--text);
  outline: none;
  transition: border-color 0.15s;
}
input[type="text"]:focus { border-color: var(--accent); }

.filter-btns { display: flex; gap: 5px; }
.filter-btn {
  padding: 6px 12px;
  font-size: 0.8rem;
  font-family: inherit;
  font-weight: 500;
  border: 1.5px solid var(--border);
  border-radius: 8px;
  background: var(--surface);
  color: var(--text2);
  cursor: pointer;
  white-space: nowrap;
  transition: all 0.15s;
}
.filter-btn.active { background: var(--accent); border-color: var(--accent); color: #fff; }

.stat {
  font-size: 0.78rem;
  color: var(--text3);
  white-space: nowrap;
  width: 100%;
  padding: 0 2px;
}

/* ── Table scroll area ── */
.table-area {
  flex: 1;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
}

table {
  width: 100%;
  border-collapse: collapse;
  font-size: 0.88rem;
}

thead th {
  background: var(--header-bg);
  color: var(--header-text);
  padding: 9px 12px;
  font-weight: 500;
  font-size: 0.73rem;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  text-align: left;
  position: sticky;
  top: 0;
  z-index: 2;
}
thead th:nth-child(2) { padding-right: 56px; }
thead th:nth-child(3) { padding-left: 56px; border-left: 1.5px solid rgba(255,255,255,0.15); }
thead th:first-child { width: 40px; text-align: center; }
thead th:nth-child(4) { width: 40px; text-align: center; }
thead th:nth-child(5) { width: 36px; text-align: center; }

tbody tr { border-bottom: 1px solid var(--border); transition: background 0.1s; }
tbody tr:last-child { border-bottom: none; }
tbody tr:nth-child(even) { background: var(--row-even); }
tbody tr:active { background: var(--accent-light); }

td { padding: 11px 12px; vertical-align: middle; }
td:first-child { text-align: center; font-family: 'JetBrains Mono', monospace; font-size: 0.72rem; color: var(--text3); }
td:nth-child(2) { padding-right: 56px; }
td:nth-child(3) { padding-left: 56px; border-left: 1.5px solid var(--border); }
td:nth-child(4) { text-align: center; }
td:nth-child(5) { text-align: center; }

.en { font-family: 'JetBrains Mono', monospace; font-size: 0.84rem; font-weight: 500; color: var(--text); }
.ko { color: var(--text2); line-height: 1.45; font-size: 0.85rem; }

.star-btn, .del-btn {
  background: none; border: none; cursor: pointer;
  border-radius: 6px; padding: 4px 5px;
  line-height: 1; transition: transform 0.15s;
}
.star-btn { font-size: 1rem; }
.del-btn { font-size: 0.9rem; color: var(--text3); }
.star-btn:active, .del-btn:active { transform: scale(1.2); }
.del-btn:hover { color: var(--red); }

.new-badge {
  font-size: 0.65rem; color: var(--accent);
  font-family: inherit; font-weight: 600;
  margin-left: 4px; vertical-align: middle;
}

.empty { text-align: center; padding: 3rem; color: var(--text3); font-size: 0.88rem; }

/* ── Add word bottom sheet ── */
.add-bar {
  background: var(--surface);
  border-top: 1.5px solid var(--border);
  padding: 10px 12px calc(env(safe-area-inset-bottom, 0px) + 10px);
  display: flex;
  gap: 7px;
  flex-shrink: 0;
  align-items: center;
}
.add-bar input {
  flex: 1;
  padding: 8px 10px;
  padding-left: 10px;
  min-width: 80px;
}
/* override the svg-padded style for add-bar inputs */
.add-bar input[type="text"] { padding: 8px 10px; }

.btn-add {
  padding: 8px 14px;
  font-size: 0.82rem;
  font-family: inherit;
  font-weight: 600;
  border: none;
  border-radius: 8px;
  background: var(--accent);
  color: #fff;
  cursor: pointer;
  white-space: nowrap;
  flex-shrink: 0;
  transition: opacity 0.15s;
}
.btn-add:active { opacity: 0.8; }

/* ── Toast ── */
.toast {
  position: fixed;
  bottom: calc(env(safe-area-inset-bottom, 0px) + 80px);
  left: 50%; transform: translateX(-50%) translateY(16px);
  background: var(--header-bg); color: var(--header-text);
  padding: 9px 18px; border-radius: 8px;
  font-size: 0.83rem; opacity: 0; pointer-events: none;
  transition: opacity 0.2s, transform 0.2s; z-index: 100;
  white-space: nowrap;
}
.toast.show { opacity: 1; transform: translateX(-50%) translateY(0); }

/* ── Install banner ── */
#install-banner {
  display: none;
  background: var(--accent);
  color: #fff;
  padding: 10px 16px;
  font-size: 0.85rem;
  justify-content: space-between;
  align-items: center;
  gap: 10px;
  flex-shrink: 0;
}
#install-banner.visible { display: flex; }
#install-banner button {
  background: #fff; color: var(--accent);
  border: none; border-radius: 6px;
  padding: 5px 12px; font-size: 0.8rem;
  font-family: inherit; font-weight: 600;
  cursor: pointer; white-space: nowrap;
}

@media print {
  .topbar-actions, .controls, .add-bar, .toast, #install-banner { display: none !important; }
  .table-area { overflow: visible; }
  td:nth-child(4), thead th:nth-child(4),
  td:nth-child(5), thead th:nth-child(5) { display: none; }
}
</style>
</head>
<body>

<div id="install-banner">
  <span>📲 홈 화면에 추가하면 앱처럼 사용할 수 있어요!</span>
  <button onclick="installApp()">설치하기</button>
</div>

<div class="topbar">
  <h1>TOEIC 단어 <span class="count-badge" id="total-badge">230</span></h1>
  <div class="topbar-actions">
    <button class="icon-btn" onclick="window.print()">🖨 인쇄</button>
  </div>
</div>

<div class="controls">
  <div class="search-wrap">
    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
    <input type="text" id="search" placeholder="영어 또는 한국어 검색..." oninput="render()">
  </div>
  <div class="filter-btns">
    <button class="filter-btn active" id="btn-all" onclick="setFilter('all')">전체</button>
    <button class="filter-btn" id="btn-star" onclick="setFilter('star')">⭐ 즐겨찾기</button>
  </div>
  <span class="stat" id="stat"></span>
</div>

<div class="table-area">
  <table>
    <thead>
      <tr>
        <th>#</th>
        <th>English</th>
        <th>한국어 뜻</th>
        <th>⭐</th>
        <th></th>
      </tr>
    </thead>
    <tbody id="tbody"></tbody>
  </table>
</div>

<div class="add-bar">
  <input type="text" id="inp-en" placeholder="영어 단어" onkeydown="if(event.key==='Enter') document.getElementById('inp-ko').focus()">
  <input type="text" id="inp-ko" placeholder="한국어 뜻" onkeydown="if(event.key==='Enter') addWord()">
  <button class="btn-add" onclick="addWord()">+ 추가</button>
</div>

<div class="toast" id="toast"></div>

<script>
// ── Service Worker 등록 ──
if ('serviceWorker' in navigator) {
  navigator.serviceWorker.register('./sw.js').catch(e => console.log('SW error:', e));
}

// ── PWA 설치 ──
let deferredPrompt = null;
window.addEventListener('beforeinstallprompt', e => {
  e.preventDefault();
  deferredPrompt = e;
  document.getElementById('install-banner').classList.add('visible');
});
window.addEventListener('appinstalled', () => {
  document.getElementById('install-banner').classList.remove('visible');
  showToast('앱이 설치됐어요 🎉');
});
function installApp() {
  if (!deferredPrompt) return;
  deferredPrompt.prompt();
  deferredPrompt.userChoice.then(() => {
    deferredPrompt = null;
    document.getElementById('install-banner').classList.remove('visible');
  });
}

// ── 단어 데이터 ──
const BASE_WORDS = [
